            {
              "id": "ab6f0304-fb14-487a-bd0b-9ee9af916e9c",
              "name": "=signal_score",
              "value": "={{ (($json.output.relevance + $json.output.impact + $json.output.novelty + $json.output.actionability) / 16) * 10 }}",
              "type": "string"
            },
            {
              "id": "6affd306-02db-49ed-ab80-a6b663d75b2c",
              "name": "=signal_level",
              "value": "={{ \n  ((($json.output.relevance + $json.output.impact + $json.output.novelty + $json.output.actionability) / 16) * 10) >= 8\n    ? \"Must Know\"\n    : ((($json.output.relevance + $json.output.impact + $json.output.novelty + $json.output.actionability) / 16) * 10) >= 6\n      ? \"Worth Knowing\"\n      : \"Noise\"\n}}",
              "type": "string"
            },
