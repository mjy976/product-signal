      "id": "9c94d305-43a2-49d2-b315-c66d27d92c5e",
      "name": "Send Daily Brief — Telegram",
      "webhookId": "54a29067-b6d8-4f38-a9c5-d16ed20d5485",
      "credentials": {
        "telegramApi": {
          "id": "kNvDrVhaA2HF3u1j",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "0f3aac1e-1ccc-4153-9624-ee1b921d9785",
              "name": "telegram_text",
              "value": "={{\n  \"🧠 PRODUCT SIGNAL\\n\" +\n  \"Daily Intelligence Brief\\n\" +\n  \"📅 \" + $now.setZone(\"Asia/Tehran\").toFormat(\"yyyy/MM/dd\") +\n  \"\\n\\n\" +\n  $json.text\n    .replace(/^## Daily Intelligence Brief/m, \"\")\n    .replace(/^### /gm, \"\")\n    .replace(/\\*\\*Source:\\*\\*/g, \"📌 Source:\")\n    .replace(/\\*\\*What happened:\\*\\*/g, \"📰 What happened:\")\n    .replace(/\\*\\*Why it matters:\\*\\*/g, \"🎯 Why it matters:\")\n    .replace(/\\*\\*Product takeaway:\\*\\*/g, \"💡 Product takeaway:\")\n    .replace(/\\*\\*Signal score:\\*\\*/g, \"📊 Signal score:\")\n    .replace(/^## Today’s Pattern/m, \"━━━━━━━━━━━━━━━━━━\\n\\n📊 TODAY'S PATTERN\")\n}}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
