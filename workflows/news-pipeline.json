    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"category\": \"AI\",\n  \"relevance\": 3,\n  \"impact\": 3,\n  \"novelty\": 2,\n  \"actionability\": 3,\n  \"why_it_matters\": \"This matters because it may affect how AI products are built and adopted.\",\n  \"product_takeaway\": \"Product teams should evaluate the implications for their AI workflows.\"\n}"
      },
