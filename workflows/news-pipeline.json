    {
      "parameters": {
        "promptType": "define",
        "text": "=You are the News Analyst for Product Signal, an AI-powered news intelligence system for Product, AI, Technology, and Business professionals.\n\nAnalyze the following news article.\n\nTitle:\n{{ $json.title }}\n\nSource:\n{{ $json.source }}\n\nPublished At:\n{{ $json.published_at }}\n\nContent:\n{{ $json.content }}\n\nEvaluate the article using these dimensions:\n\n1. category:\nChoose exactly one:\nProduct, AI, Technology, Business, Startup, Strategy, Other\n\n2. relevance:\nScore from 0 to 4 for relevance to a Product/Business/Technology professional.\n0 = Not relevant\n4 = Highly relevant\n\n3. impact:\nScore from 0 to 4 for potential business, product, technology, or market impact.\n0 = Negligible\n4 = Very high\n\n4. novelty:\nScore from 0 to 4 based on how new or significant the information is.\n0 = Not novel\n4 = Highly novel\n\n5. actionability:\nScore from 0 to 4 based on whether a professional could learn from, react to, or act on this information.\n0 = Not actionable\n4 = Highly actionable\n\n6. why_it_matters:\nExplain in 1-2 concise sentences why this news matters.\n\n7. product_takeaway:\nGive one concise takeaway for a Product Manager or Product professional.\n\nReturn ONLY valid JSON.\nDo not include markdown.\nDo not include ```json.\nDo not include any text before or after the JSON.\n\nUse exactly this structure:\n\n{\n  \"category\": \"AI\",\n  \"relevance\": 0,\n  \"impact\": 0,\n  \"novelty\": 0,\n  \"actionability\": 0,\n  \"why_it_matters\": \"\",\n  \"product_takeaway\": \"\"\n}",
        "hasOutputParser": true,
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        896,
        -48
      ],
      "id": "6f24c4a9-40d5-47a7-8066-0789a7bd9e34",
      "name": "Basic LLM Chain1"
    },
